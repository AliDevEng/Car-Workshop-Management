# Normalise all text files to LF, regardless of each contributor's local
# core.autocrlf setting. Matches .editorconfig's end_of_line = lf.
#
# This matters beyond tidiness: infra/ ships shell scripts that run inside
# Linux containers, and a script checked out with CRLF line endings fails
# there with a "bad interpreter" error.
* text=auto eol=lf

# Binary assets: never touched by line-ending conversion.
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
