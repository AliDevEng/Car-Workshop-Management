// Verkstadssystem — database schema.
//
// Models are added by the iteration that owns them (PROJECT_SPEC.md §4):
// B2 User/Session, B3 Customer/Vehicle/OdometerReading, B4 Article/
// StockMovement, and so on. B0 establishes only the connection, the generated
// client and the extension migration everything later depends on.

generator client {
  provider = "prisma-client"

  // Explicit output, inside src/ so the backend build compiles it (B0.4.3).
  // Prisma 7 has no default location; leaving it out is an error, not a
  // fallback to node_modules.
  output = "../src/generated/prisma"

  runtime      = "nodejs"
  moduleFormat = "esm"

  // ESM on NodeNext resolves relative imports by their runtime path, so the
  // generated .ts files must import each other with a .js extension.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"

  // No `url` here: Prisma 7 removed it from the schema. Migrate and the other
  // CLI commands read the connection string from prisma.config.ts, and the
  // application supplies it through the driver adapter passed to
  // `new PrismaClient({ adapter })` (B0.4.4, B0.4.5).
}

// ---------------------------------------------------------------------------
// B2 — staff, sessions and the audit foundation (PROJECT_SPEC.md §4.2, §5.1).
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MECHANIC
}

/// Staff only. Two rows in practice; the role split exists so price lists and
/// user management can be locked down without a later migration (§5.3).
model User {
  id           String   @id @default(uuid(7))
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  /// Deactivated, never deleted (§4.3). A dismissed admin must lose access
  /// without their audit trail losing its actor.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  sessions               Session[]
  auditLogs              AuditLog[]
  odometerReadings       OdometerReading[]
  stockMovements         StockMovement[]
  assignedBookings       Booking[]
  handledBookingRequests BookingRequest[]
  assignedWorkOrders     WorkOrder[]       @relation("WorkOrderAssignedTo")
  completedWorkOrders    WorkOrder[]       @relation("WorkOrderCompletedBy")
  idempotencyKeys        IdempotencyKey[]
  generatedDocuments     Document[]

  @@index([isActive])
}

/// A logged-in browser (§5.1). Sessions rather than JWT because a dismissed
/// admin must lose access *now*, and a revocation list is a session table with
/// more moving parts.
model Session {
  /// 256 bits of randomness, generated in `modules/auth/service.ts`. Not a
  /// `@default`: the value has to be the same string the signed cookie
  /// carries, so the application generates it rather than the database.
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @db.Timestamptz(3)
  /// Moved forward on activity; the 30-day expiry slides with it (§5.1).
  lastSeenAt DateTime @db.Timestamptz(3)
  /// Salted SHA-256, never a raw address (§5.5).
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  /// The hourly cleanup job (§8.4) scans this.
  @@index([expiresAt])
}

/// Append-only (§4.2). No update or delete route exists for this table, and
/// none should be added — an audit log that can be edited is not one.
model AuditLog {
  id         String   @id @default(uuid(7))
  /// Null for a scheduled job rather than a person (§8.4).
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  /// Passwords, password hashes and session ids are redacted before these are
  /// written (B2.7.2) — the log records what changed, not the secret.
  beforeJson Json?
  afterJson  Json?
  ipHash     String?
  at         DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([at])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// B3 — the core register everything else hangs off (PROJECT_SPEC.md §4.2,
// §6.3). A vehicle can exist before anyone knows whose it is, and its owner
// can change without the service history moving, because history hangs off
// the vehicle rather than the customer.
// ---------------------------------------------------------------------------

enum CustomerType {
  PRIVATE
  COMPANY
}

/// A workshop customer. Phone is the required contact channel; email is
/// optional because a real workshop's list is half phone-only (§4.2).
model Customer {
  id              String       @id @default(uuid(7))
  type            CustomerType
  name            String
  orgNumber       String?
  email           String?
  /// Exactly what the customer gave — `070-123 45 67` (§8.2).
  phone           String
  /// The same number in E.164, derived by the service via `shared/phone.ts`.
  /// Both columns are stored and both are searched: normalising only one side
  /// breaks the moment a customer is looked up by digits they recite, or by a
  /// number a colleague wrote a different way last year (§8.2).
  phoneNormalised String
  address         String?
  notes           String?
  /// Set when a GDPR erasure request is honoured. The customer is anonymised,
  /// never hard-deleted — the documents they appear on must survive (§5.5).
  anonymisedAt    DateTime?    @db.Timestamptz(3)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  vehicles   Vehicle[]
  bookings   Booking[]
  workOrders WorkOrder[]

  @@index([isActive])
  /// §8.2 searches on the normalised form; the global search (§6.3, B3.4)
  /// matches every contact column with `ILIKE '%q%'`, which the trigram
  /// operator class accelerates.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phoneNormalised(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// A vehicle. `customerId` is optional and this is load-bearing: a
/// registration number is looked up before anyone knows whose car it is — on
/// the public start page — and requiring an owner would force fake customer
/// records (§4.2).
model Vehicle {
  id                        String  @id @default(uuid(7))
  /// The canonical, unspaced form (`shared/regnr.ts`). The unique index is
  /// what makes two spellings of one plate impossible.
  registrationNumber        String  @unique
  /// `ABC 12D` — what a human reads.
  registrationNumberDisplay String
  /// Personalised plates and imports exist: a value failing the standard
  /// format is accepted and flagged for a human rather than blocking a
  /// booking (§4.2).
  isNonStandardPlate        Boolean @default(false)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  make                  String
  model                 String
  variant               String?
  modelYear             Int?
  vin                   String?
  engineCode            String?
  fuelType              String?
  firstRegistrationDate DateTime? @db.Date
  lastInspectionDate    DateTime? @db.Date
  nextInspectionDueDate DateTime? @db.Date
  /// A cache of the newest `OdometerReading`. The reading history is the
  /// record (§4.2); this column exists so a list does not need a subquery.
  lastKnownOdometerKm   Int?
  /// When the external provider last answered for this plate (§7.1).
  dataFetchedAt         DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  odometerReadings OdometerReading[]
  bookings         Booking[]
  workOrders       WorkOrder[]

  @@index([customerId])
  /// The dashboard scans this daily for inspections due within 60 days (§8.2).
  @@index([nextInspectionDueDate])
  /// Global search (§6.3, B3.4): the query is normalised for the canonical
  /// column and matched as typed against the display, make and model.
  @@index([registrationNumber(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([registrationNumberDisplay(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([make(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([model(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum OdometerSource {
  WORK_ORDER_IN
  WORK_ORDER_OUT
  MANUAL
  EXTERNAL
}

/// Kept separate from `Vehicle.lastKnownOdometerKm` so the history — and
/// therefore the service engine's baseline — survives a correction (§4.2).
model OdometerReading {
  id          String         @id @default(uuid(7))
  vehicleId   String
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// Stored in km. The UI labels every input `mil` and converts on submit
  /// (§3.5). `Int`, not `Decimal` — a reading is a whole number of km.
  km          Int
  readAt      DateTime       @db.Timestamptz(3)
  source      OdometerSource
  /// Null for a reading imported from an external source rather than entered
  /// by a person (§4.2). `SetNull` because a reading must outlive the account.
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Set when the reading came from a work order's in or out reading (B6.7).
  /// `SetNull`: §4.3 allows deleting a `DRAFT` work order, and the reading
  /// taken when the car arrived is a fact about the car either way.
  workOrderId String?
  workOrder   WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, readAt])
  @@index([workOrderId])
}

/// Key/value workshop settings (§4.2). One row per settings group, each value
/// a JSON blob validated by its `shared` schema in `config/settings.ts` — no
/// feature code does a raw string lookup. Writes are ADMIN-only and arrive in
/// B9.7; B3 only reads.
model Setting {
  key             String   @id
  valueJson       Json
  updatedByUserId String?
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// B4 — the article catalogue and the stock ledger (PROJECT_SPEC.md §4.2,
// §6.4). The ledger is the truth and `Article.stockQuantity` is a cache: every
// movement writes a ledger row and updates the cache in one transaction, with
// the article row locked (`SELECT ... FOR UPDATE`). A nightly job re-derives
// the balance from the ledger and logs any drift.
// ---------------------------------------------------------------------------

enum Unit {
  PIECE
  LITRE
  HOUR
  KIT
}

enum StockMovementType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
  STOCKTAKE
  RETURN
}

/// A stocked part, consumable or labour rate. Prices are integer öre (§3.2) —
/// never a float, never a Decimal. Quantities are `Decimal(12, 3)` (§3.4). A
/// work-order line snapshots this row's name, price, unit and VAT when it is
/// added (§4.2, B6); it never joins back to the live article for display.
model Article {
  id               String   @id @default(uuid(7))
  sku              String   @unique
  name             String
  description      String?
  unit             Unit
  /// Excluding VAT (§3.3), in integer öre (§3.2).
  salesPriceOre    Int
  purchasePriceOre Int?
  /// VAT rate in basis points; `2500` is 25 % (§3.3). Stored per row so a
  /// future rate change does not rewrite history.
  vatRateBps       Int      @default(2500)
  /// A **cache** of the ledger, not the truth. `StockMovement` is the record;
  /// this column exists so reading a balance is one cheap column read (§4.2),
  /// and it is only ever written inside the same transaction as a movement.
  stockQuantity    Decimal  @default(0) @db.Decimal(12, 3)
  minimumQuantity  Decimal  @default(0) @db.Decimal(12, 3)
  /// Shelf location.
  location         String?
  /// OE numbers as printed on the part — what makes the partner-link buttons
  /// useful (§7.2). Uppercased and stripped of spaces by the service.
  oeNumbers        String[]
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  movements      StockMovement[]
  workOrderLines WorkOrderLine[]
  quoteLines     QuoteLine[]

  @@index([isActive])
  /// The global search (§6.3, B4.6) and the article list `?q=` (B4.1.2) match
  /// SKU and name with `ILIKE '%q%'`, which the trigram operator class
  /// accelerates — the arrangement B3 uses for customers and vehicles.
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  /// `?q=` also matches an OE number exactly; a GIN index serves the array
  /// containment lookup.
  @@index([oeNumbers], type: Gin)
}

/// One entry in the stock ledger (§4.2, §6.4). Append-only — a correction is a
/// new movement, never an edit. `quantity` is signed: a consumption is
/// negative, a purchase positive, and the running sum of the column is the
/// balance, so there is no separate direction flag that could disagree with
/// the sign.
model StockMovement {
  id           String            @id @default(uuid(7))
  articleId    String
  article      Article           @relation(fields: [articleId], references: [id], onDelete: Restrict)
  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 3)
  /// The cached balance immediately after this movement, so the chain can be
  /// audited without replaying it from the beginning.
  balanceAfter Decimal           @db.Decimal(12, 3)
  /// Set when the movement came from completing or reverting a work order
  /// (B6.6). `Restrict` rather than `SetNull`: a ledger row that has lost the
  /// job it belongs to cannot answer "why did the oil run out?", which is the
  /// question §4.2 keeps the ledger for. Only a `DRAFT` order is deletable
  /// (§4.3) and a draft has deducted nothing, so this never actually fires.
  workOrderId  String?
  workOrder    WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  /// Who recorded it. Required by §4.2; users are deactivated rather than
  /// deleted (§4.3), so `Restrict` never actually fires.
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  note         String?
  occurredAt   DateTime          @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  /// §8.2: the per-article movement list reads this newest-first.
  @@index([articleId, occurredAt])
  @@index([workOrderId])
}

// ---------------------------------------------------------------------------
// B5 — booking requests and the calendar (PROJECT_SPEC.md §4.2, §6.2).
//
// The split between the two models is the point of the feature: a public
// submission creates a *request*, never a booking. The two owners decide what
// actually goes in the calendar, which removes the whole class of problems
// around bay availability and jobs whose real duration is unknown until the
// car is on the lift.
// ---------------------------------------------------------------------------

enum BookingRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
  SPAM
}

enum RequestedTimeOfDay {
  MORNING
  AFTERNOON
  ANY
}

enum BookingStatus {
  SCHEDULED
  IN_PROGRESS
  DONE
  CANCELLED
  NO_SHOW
}

/// What an anonymous visitor submitted (§4.2, §6.2). Data minimisation is a
/// requirement, not a style choice: name, phone, optional email, registration
/// number and a free-text message, and nothing else (§5.5).
model BookingRequest {
  id     String               @id @default(uuid(7))
  status BookingRequestStatus @default(PENDING)

  /// Normalised when it parses as a plate, stored as typed when it does not —
  /// a personalised plate must not block a booking (§4.2). No relation: the
  /// car may be unknown to the workshop until a human confirms the request.
  regNr              String?
  customerName       String
  phone              String
  email              String?
  /// A wish, not a slot. The staff member picks the real time on confirmation.
  requestedDate      DateTime?           @db.Date
  requestedTimeOfDay RequestedTimeOfDay?
  /// The services picked on the public site (§6.1). Opaque identifiers, held
  /// as submitted so a later rename of a service page cannot rewrite history.
  serviceTypeIds     String[]
  message            String?

  /// Salted SHA-256, never a raw address (§5.5). Kept so a burst of spam can
  /// be traced to one visitor without storing who they are.
  sourceIpHash String?
  submittedAt  DateTime @default(now()) @db.Timestamptz(3)

  handledByUserId String?
  handledBy       User?     @relation(fields: [handledByUserId], references: [id], onDelete: SetNull)
  handledAt       DateTime? @db.Timestamptz(3)
  /// Why it was rejected. Shown to staff, never sent to the visitor by v1.
  rejectionReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  booking Booking?

  /// The inbox is "everything still PENDING, newest first", and the badge in
  /// the navigation counts the same rows (§6.2).
  @@index([status, submittedAt])
}

/// A slot in the workshop's calendar (§4.2, §6.2).
///
/// Overlap is prevented by a Postgres `EXCLUDE USING gist` constraint added in
/// this model's migration, not by a check-then-insert in application code:
/// checking first and hoping is the race condition, and a constraint is not.
/// Prisma cannot express an exclusion constraint, so it lives in raw SQL —
/// `backend/src/modules/bookings/booking.repository.ts` documents the SQLSTATE
/// it raises and where that is turned into a `409`.
model Booking {
  id String @id @default(uuid(7))

  /// Set when the booking came from a public request. Unique: a request
  /// becomes at most one booking, so a double-tapped **Bekräfta** is refused
  /// by the database and not only by the status check above it.
  bookingRequestId String?         @unique
  bookingRequest   BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: SetNull)

  /// Required: the calendar is a promise to a person. The car may still be
  /// unknown — a customer books before anyone has seen the plate.
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleId  String?
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  /// UTC instants (§3.6). Every boundary the API is asked about is interpreted
  /// in Europe/Stockholm and converted in `shared/time.ts`.
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  /// Optional, and the exclusion constraint is partial on it: an unassigned
  /// booking occupies nobody's calendar and so cannot conflict (B5.4.4).
  assignedUserId String?
  assignedUser   User?         @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  status         BookingStatus @default(SCHEDULED)
  note           String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// §8.2 names this one: the calendar reads a date window, optionally for one
  /// mechanic.
  workOrders WorkOrder[]

  @@index([startsAt, assignedUserId])
  @@index([customerId])
  @@index([vehicleId])
}

// ---------------------------------------------------------------------------
// B6 — work orders, their lines and the idempotency ledger (PROJECT_SPEC.md
// §4.2, §4.4, §6.5).
//
// The transactional heart of the system. Three rules hold everything together
// and each has a comment where it is enforced:
//
//   * a line **snapshots** the article's name, price, unit and VAT when it is
//     added, and never joins back to the live article for display;
//   * stock is deducted **once**, on the move to `COMPLETED`, guarded by
//     `stockDeducted` per line, and a revert writes compensating `RETURN`
//     movements rather than deleting the originals;
//   * `version` is an optimistic lock over the header and the status, not over
//     the lines — two mechanics adding different lines to one job is correct
//     behaviour and must not fail.
// ---------------------------------------------------------------------------

enum WorkOrderStatus {
  DRAFT
  IN_PROGRESS
  AWAITING_PARTS
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum WorkOrderLineType {
  LABOUR
  PART
  FEE
}

/// A job (§4.2, §6.5).
model WorkOrder {
  id String @id @default(uuid(7))

  /// `AO-2026-0001`, from a Postgres sequence inside the assigning transaction
  /// (§4.4) — never `SELECT MAX(number) + 1`. **Null while the order is a
  /// `DRAFT`:** §4.4 assigns a number when a document stops being an
  /// abandonable draft, and §4.3 permits deleting a `DRAFT` outright, which
  /// would otherwise leave a gap in the series. Assigned once, the first time
  /// the order leaves `DRAFT`, and never reassigned.
  number String? @unique

  /// The calendar slot this job came from, if any. Not unique: a booking that
  /// turns out to be two jobs is a normal morning.
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  /// Required, and `Restrict` on both: a work order without a car or a payer
  /// is not a work order, and neither is ever hard-deleted (§4.3).
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  status WorkOrderStatus @default(DRAFT)

  /// Stored in km, displayed in mil (§3.5). Both are also written to
  /// `OdometerReading`, which is the history; these are the job's own record
  /// of what the car showed when it arrived and when it left.
  odometerKmIn  Int?
  odometerKmOut Int?

  assignedUserId String?
  assignedUser   User?   @relation("WorkOrderAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)

  description  String
  internalNote String?

  completedAt       DateTime? @db.Timestamptz(3)
  /// Who pressed *Slutför* (B6.5.3). `SetNull` because the record must outlive
  /// the account, exactly as an audit row does.
  completedByUserId String?
  completedBy       User?     @relation("WorkOrderCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  /// Optimistic lock (§6.5). Incremented by **every** write, including a line
  /// write, but only checked on header and status mutations — see
  /// `modules/work-orders/repository.ts`.
  version Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  lines            WorkOrderLine[]
  odometerReadings OdometerReading[]
  stockMovements   StockMovement[]
  quotes           Quote[]

  /// §8.2 names this one: the dashboard and the list filter on status.
  @@index([status])
  @@index([vehicleId])
  @@index([customerId])
  @@index([bookingId])
  @@index([assignedUserId])
}

/// One line on a work order (§4.2).
///
/// `description`, `unit`, `unitPriceOre` and `vatRateBps` are **snapshots**
/// taken from the article when the line was added. They are never re-read from
/// `Article`: if oil goes up 30 kr next month, a quote printed today must
/// still print today's price. `articleId` is kept so stock can be deducted and
/// the part traced — not so the row can be joined for display.
model WorkOrderLine {
  id          String    @id @default(uuid(7))
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  /// Explicit display order, so a mechanic can group parts under the labour
  /// they belong to. Contiguous from 0 within an order.
  sortOrder Int
  type      WorkOrderLineType

  /// Absent on a free-text line and on labour. `Restrict`, mirroring
  /// `StockMovement`: articles are deactivated, never deleted (§4.3).
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Restrict)

  description  String
  quantity     Decimal @db.Decimal(12, 3)
  unit         Unit
  /// Excluding VAT, integer öre (§3.2, §3.3).
  unitPriceOre Int
  vatRateBps   Int

  /// Set once, when the order moves to `COMPLETED` (§6.4). Adding a `PART`
  /// line does not deduct stock; this flag is what makes a re-run — a
  /// double-tapped *Slutför* on a laggy tablet — safe. A revert clears it and
  /// writes a compensating `RETURN` movement.
  stockDeducted Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([workOrderId, sortOrder])
  @@index([articleId])
}

/// A replayed mutation's stored answer (§4.2, §8.1).
///
/// The row is written **inside the same transaction as the effect it
/// describes** (B6.6.3). Written afterwards, a crash between the two leaves a
/// retry free to deduct stock a second time, which is the exact failure the
/// mechanism exists to prevent.
model IdempotencyKey {
  /// Caller-chosen and globally unique, as §4.2 specifies. `userId` is stored
  /// beside it and checked on replay, so one caller's key cannot return
  /// another caller's stored response.
  key    String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The route the key was used on, and a hash of the request it stood for. A
  /// matching key with a *different* hash is a `409`: that means a bug, not a
  /// retry.
  endpoint    String
  requestHash String

  responseJson Json
  statusCode   Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  /// Rows older than 24 hours are removed by the hourly cleanup job (§8.4).
  @@index([createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// B7 — quotes and the generated-document store (PROJECT_SPEC.md §4.2, §6.6,
// §8.3).
//
// Two rules hold this pair together:
//
//   * **The stored file is the record.** `Document` carries the SHA-256 of the
//     bytes on disk plus the exact payload they were rendered from, so a
//     three-year-old offert can be verified and explained even after the
//     template has changed. It is never regenerated in place and never
//     deleted.
//   * **A sent quote is immutable.** Its lines are copied out of the work
//     order when the quote is created, not joined back to it, and a change
//     after sending is a new `Quote` row pointing at the one it replaces —
//     what the customer received always still exists (§6.6).
// ---------------------------------------------------------------------------

enum DocumentType {
  QUOTE
  SERVICE_PROTOCOL
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

/// A rendered PDF and everything needed to account for it (§4.2, §8.3).
model Document {
  id     String       @id @default(uuid(7))
  type   DocumentType
  /// `OF-2026-0001` / `SP-2026-0001`, from the same per-type-per-year sequence
  /// the work order draws `AO-` from (§4.4). Globally unique because the
  /// prefix is part of the value.
  number String       @unique

  /// Relative to `STORAGE_PATH`, as `documents/YYYY/MM/<number>.pdf`. Stored
  /// relative rather than absolute so a restore onto a different volume — or
  /// into a container with a different mount point — finds its own files.
  /// Never returned by the API: the bytes are fetched by document id.
  filePath       String
  /// Proves the **stored** file has not been altered since it was written
  /// (§4.2). It is an integrity check on the artefact, not a determinism
  /// claim about the renderer.
  fileHashSha256 String
  sizeBytes      Int

  /// The exact data the PDF was rendered from, so the content can be
  /// reconstructed and explained even if the template has changed since
  /// (§4.2). Without it, a template change silently rewrites the past.
  payloadJson Json

  /// Also the PDF's pinned creation and modification date. B0.10.1 established
  /// that pinning it is what makes a re-render byte-identical; reading the
  /// clock at render time is what makes it not.
  generatedAt       DateTime @db.Timestamptz(3)
  /// Required by §4.2. `Restrict` because users are deactivated rather than
  /// deleted (§4.3), so it never actually fires — and a document that has lost
  /// the person who issued it cannot answer the question it is kept for.
  generatedByUserId String
  generatedBy       User     @relation(fields: [generatedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  quote Quote?

  @@index([type, generatedAt])
  @@index([generatedByUserId])
}

/// An offert (§4.2, §6.6).
model Quote {
  id String @id @default(uuid(7))

  /// `Restrict`, not `Cascade`: §4.3 permits deleting a `DRAFT` work order,
  /// and a quote — even an unsent one — is a promise that was made about a
  /// price. The order must be emptied of quotes deliberately, never as a side
  /// effect of removing a draft.
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  /// `OF-2026-0001`, from the §4.4 sequence, **null while the quote is a
  /// `DRAFT`**: §4.4 spends a number when a document is finalised, and for a
  /// quote that moment is unambiguously the send (§6.6).
  number String? @unique

  /// Which version of this work order's quote this is, counting from 1
  /// (B7.5.2). Unique per order, so two people revising the same sent quote
  /// at once produce one winner and one `409` rather than two "version 2"s.
  revision Int @default(1)

  /// The sent quote this one replaces (B7.5.1). Unique: a quote is superseded
  /// at most once, which is what stops a version *tree* forming where §6.6
  /// describes a chain.
  supersedesQuoteId String? @unique
  supersedes        Quote?  @relation("QuoteRevision", fields: [supersedesQuoteId], references: [id], onDelete: Restrict)
  supersededBy      Quote?  @relation("QuoteRevision")

  status     QuoteStatus @default(DRAFT)
  /// A calendar date, not an instant: a quote valid until the 30th is valid
  /// for the whole of the 30th in the workshop's own day (§3.6).
  validUntil DateTime    @db.Date

  /// Frozen at creation, summed from already-rounded line values (§3.3). A
  /// work order computes its totals on read because its lines change; a quote
  /// stores them because its lines do not, and because the numbers the
  /// customer was given must survive a change to how totals are calculated.
  netOre      Int
  vatOre      Int
  grossOre    Int
  /// Display-only öresavrundning; never fed back into a line value (§3.3).
  roundingOre Int

  /// Written on send, together with the number and the `SENT` status (§6.6).
  documentId String?   @unique
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  sentAt      DateTime? @db.Timestamptz(3)
  respondedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  lines QuoteLine[]

  @@unique([workOrderId, revision])
  @@index([workOrderId])
  /// The expiry sweep (§8.4, wired by B11) scans `SENT` rows by `validUntil`.
  @@index([status, validUntil])
}

/// A line as it stood when the quote was created (B7.3.2).
///
/// Copied out of `WorkOrderLine`, never joined back to it. The work order's
/// lines go on changing — that is what a work order is for — and §6.6 requires
/// that what the customer received always still exists. This is the same
/// snapshot rule §4.2 applies between a work-order line and its article, one
/// level up.
model QuoteLine {
  id      String @id @default(uuid(7))
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  sortOrder Int
  type      WorkOrderLineType

  /// Traceability only — which part was quoted. `Restrict`, mirroring
  /// `WorkOrderLine`: articles are deactivated, never deleted (§4.3).
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Restrict)

  description  String
  quantity     Decimal @db.Decimal(12, 3)
  unit         Unit
  unitPriceOre Int
  vatRateBps   Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([quoteId, sortOrder])
  @@index([articleId])
}
