{
  "name": "verkstad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.22.0 <23.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "prepare": "pnpm --filter shared build && pnpm --filter backend prisma:generate",
    "dev": "pnpm --filter shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "type-coverage": "type-coverage --at-least 99.5",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm type-coverage",
    "db:migrate": "pnpm --filter backend exec prisma migrate dev",
    "db:studio": "pnpm --filter backend exec prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "type-coverage": "2.30.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "typeCoverage": {
    "atLeast": 99.5,
    "ignoreFiles": [
      "backend/src/generated/**",
      "**/dist/**",
      "**/.next/**",
      "**/coverage/**"
    ]
  }
}
